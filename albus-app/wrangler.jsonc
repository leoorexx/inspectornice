{
  // Albus: Dumbledores lebendes Porträt als eigene Web-App für das iPad.
  "name": "twilight-smoke-94ba",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./public", "binding": "ASSETS" },
  // Gedächtnis, Bild und Wetter liegen in einem Durable Object (SQLite), das zum Worker gehört.
  "durable_objects": { "bindings": [{ "name": "STORE", "class_name": "AlbusStore" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AlbusStore"] }],
  // Wetter für Bornheim: 5:43 und 14:43 Uhr (Winterzeit; Cron läuft in UTC).
  "triggers": { "crons": ["43 4,13 * * *"] },
  "vars": {
    "ALBUS_MODEL": "claude-opus-5-5",
    "ELEVENLABS_MODEL": "eleven_multilingual_v2",
    // Dumbledores Stimme aus ElevenLabs (nicht geheim; der API-Schlüssel ist ein Secret)
    "ELEVENLABS_VOICE_ID": "5KvpaGteYkNayiswuX2h"
  }
}
